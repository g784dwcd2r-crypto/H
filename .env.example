# Required by the SEC fair-access policy: "Company Name contact@email"
SEC_USER_AGENT="Filings Hub you@example.com"

# Lake root. Local directory or s3://bucket/prefix (install the [s3] extra for S3).
LAKE_ROOT=./data
# Legacy alias kept for the plan's naming; if set and LAKE_ROOT is unset, the lake is s3://$S3_BUCKET/filings-hub
S3_BUCKET=

# Serving database. Postgres for production; leave empty to serve straight from the lake with DuckDB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/filings_hub

# Optional: alerts for the daily refresh
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Phase 2 API
API_KEY=change-me
API_RATE_LIMIT_PER_MINUTE=60
