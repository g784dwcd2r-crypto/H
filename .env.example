# Required by the SEC fair-access policy: "Company Name contact@email"
SEC_USER_AGENT="Disclosure you@example.com"

# EDGAR client: 10 req/s is the SEC limit. A 403/429 is an SEC throttle (~10 min block); these rounds wait it out.
EDGAR_REQUESTS_PER_SECOND=10
EDGAR_THROTTLE_RETRIES=8
EDGAR_THROTTLE_MAX_WAIT_SECONDS=600

# Lake root. Local directory or s3://bucket/prefix (install the [s3] extra for S3).
LAKE_ROOT=./data
# Legacy alias kept for the plan's naming; if set and LAKE_ROOT is unset, the lake is s3://$S3_BUCKET/filings-hub
S3_BUCKET=

# S3 lake: leave AWS_ACCESS_KEY_ID empty to use the default AWS credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# S3-compatible endpoint (MinIO, Cloudflare R2, a local mock); empty = AWS.
AWS_ENDPOINT_URL=

# Serving database. Postgres for production; leave empty to serve straight from the lake with DuckDB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/filings_hub

# Optional: alerts for the daily refresh
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Phase 2 API
API_KEY=change-me
# Per verified user or gateway visitor; direct API requests fall back to peer IP.
API_RATE_LIMIT_PER_MINUTE=60
# Verified account emails allowed to open private operations and option analytics. Empty denies all.
ADMIN_EMAILS=

# Public URL of the web app, used in the watchlist digest emails (sent through the SMTP settings above).
SITE_URL=

# Accounts. Sign-in links go out through the SMTP settings above; SESSION_SECRET signs the session
# cookie (any long random string). Google sign-in is optional: an OAuth client with the redirect URI
# {SITE_URL}/auth/google/callback. AUTH_DEV_LINKS=true returns the link in the API response (dev only).
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_DEV_LINKS=false
